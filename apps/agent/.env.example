# Obrigatório — o agente LangGraph chama a API OpenAI com ferramentas.
OPENAI_API_KEY=

# Porta HTTP do agente (uvicorn)
# AGENT_PORT=8001

# Origens CORS separadas por vírgula (útil para testar o agente direto no browser).
# Por omissão: localhost:5173 e 127.0.0.1:5173
# AGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
