# Obrigatório em produção e para chamadas reais à API OpenAI.
# Nunca commite ficheiros .env com a chave real.
OPENAI_API_KEY=

# Lista separada por vírgulas de IDs de modelo permitidos (o cliente só pode escolher estes).
# Se vazio, o servidor usa: gpt-4o-mini, gpt-4o, gpt-4-turbo
# ALLOWED_MODELS=gpt-4o-mini,gpt-4o

# Origem(s) do frontend para CORS (separadas por vírgula). Por omissão: http://localhost:5173
# Se aceder ao Vite por IP noutra máquina (ex.: http://192.168.1.10:5173), inclua essa URL aqui.
# CORS_ORIGIN=http://localhost:5173,http://192.168.1.10:5173

# Porta HTTP do servidor
# PORT=3001
